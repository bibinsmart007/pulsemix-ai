# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

__pycache__/
*.pyc
*.db
public/downloads/
public/exports/
test.wav


# === Post-party cleanup ===
# Redis binaries (Windows) - should be downloaded fresh, not committed
redis/
redis.zip
dump.rdb

# Sandbox scratch (intermediate test files, render chunks)
scratch/

# Mock audio test files (for unit tests, not for production)
public/storage/

# Render output files (regenerated from sources)
public/exports/*.mp3
public/exports/*.wav
public/exports/*.mka
public/exports/*.ogg
public/exports/*.flac
